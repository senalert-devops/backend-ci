# Exemple pour le développement local : copier en .env et remplir. Ne jamais committer .env.
# Sur Kubernetes, ces valeurs viennent du Secret "senalert-secret" et du ConfigMap "senalert-config".
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/senalert
ADMIN_USER=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
# Optionnel : sinon la clé de signature est dérivée de ADMIN_PASSWORD
SECRET_KEY=
